{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer-scope.local/model-manifest.schema.json",
  "title": "Transformer Microscope model manifest v1",
  "type": "object",
  "required": ["schemaVersion", "architectureVersion", "modelId", "modelRevision", "config", "dtype", "matrixOrientation", "conventions", "weightsFile", "tokenizerFile", "weightsSha256", "tokenizerSha256", "tensors", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "architectureVersion": { "const": "preln-absolute-tied-v1" },
    "modelId": { "type": "string", "minLength": 1 },
    "modelRevision": { "$ref": "#/$defs/hash" },
    "dtype": { "const": "float32-le" },
    "matrixOrientation": { "const": "input-output" },
    "weightsFile": { "$ref": "#/$defs/filename" },
    "tokenizerFile": { "$ref": "#/$defs/filename" },
    "weightsSha256": { "$ref": "#/$defs/hash" },
    "tokenizerSha256": { "$ref": "#/$defs/hash" },
    "config": {
      "type": "object",
      "required": ["layers", "heads", "modelDim", "mlpDim", "vocabularySize", "contextLength", "layerNormEpsilon"],
      "properties": {
        "layers": { "type": "integer", "minimum": 1, "maximum": 16 },
        "heads": { "type": "integer", "minimum": 1 },
        "modelDim": { "type": "integer", "minimum": 1, "maximum": 512 },
        "mlpDim": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "vocabularySize": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "contextLength": { "type": "integer", "minimum": 1, "maximum": 512 },
        "layerNormEpsilon": { "const": 0.00001 }
      }
    },
    "conventions": {
      "type": "object",
      "required": ["gelu", "layerNormVariance", "position", "tiedEmbeddings", "dropout", "maskValue"],
      "properties": {
        "gelu": { "const": "tanh" },
        "layerNormVariance": { "const": "population" },
        "position": { "const": "learned-absolute" },
        "tiedEmbeddings": { "const": true },
        "dropout": { "const": 0 },
        "maskValue": { "const": -1000000000 }
      }
    },
    "tensors": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "shape", "byteOffset", "byteLength"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "shape": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
          "byteOffset": { "type": "integer", "minimum": 0, "multipleOf": 4 },
          "byteLength": { "type": "integer", "minimum": 4, "multipleOf": 4 }
        }
      }
    },
    "provenance": {
      "type": "object", "required": ["purpose", "seed", "torchVersion", "generatorVersion"],
      "properties": {
        "purpose": { "type": "string" }, "seed": { "type": "integer" },
        "torchVersion": { "type": "string" }, "generatorVersion": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "filename": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" }
  },
  "$comment": "Runtime validation additionally enforces dimension divisibility, exact tensor names/shapes, contiguous byte ranges, total payload limits, checksums, and finite weight values."
}
