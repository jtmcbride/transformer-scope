{
  "name": "transformer-scope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/write_release.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "benchmark:cache": "vitest run --config vitest.benchmark.config.ts",
    "fixtures": ".venv/bin/python scripts/export_fixtures.py",
    "train:retrieval": ".venv/bin/python scripts/train_retrieval.py",
    "test:data": ".venv/bin/python -m unittest discover -s scripts -p 'test_*.py'",
    "fixtures:inspection": ".venv/bin/python scripts/export_inspection.py",
    "benchmark:browser": "playwright test --config playwright.benchmark.config.ts && node scripts/collect_browser_benchmark.mjs",
    "check:artifacts": "python3 scripts/check_artifacts.py --models public/models && python3 scripts/check_artifacts.py --models dist/models",
    "test:hosted": "playwright test --config playwright.hosted.config.ts",
    "analysis:heads": "vitest run --config vitest.analysis.config.ts",
    "fixtures:exploration": ".venv/bin/python scripts/export_exploration.py",
    "fixtures:residual": ".venv/bin/python scripts/export_residual.py"
  },
  "dependencies": {
    "@tensorflow/tfjs-core": "4.22.0",
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-backend-webgl": "4.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
